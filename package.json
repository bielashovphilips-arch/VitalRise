{
  "name": "vitalrise",
  "version": "0.1.0",
  "private": true,
  "description": "VitalRise static athlete dashboard and calculators.",
  "scripts": {
    "test:growth": "node --test tests/site-regression.test.mjs",
    "test:owner": "node --test tests/owner-access.test.mjs",
    "test:training": "node --test tests/training-release.test.mjs",
    "build:index": "powershell -ExecutionPolicy Bypass -File tools/build-index.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File tools/dev-server.ps1",
    "dev:access": "node tools/access-server.js",
    "dev:access:mock": "set ACCESS_MOCK_PAYMENTS=1&& node tools/access-server.js",
    "check": "powershell -ExecutionPolicy Bypass -File tools/check-project.ps1"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "miniflare": "4.20260721.0"
  }
}
